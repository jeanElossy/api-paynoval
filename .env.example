# ─── Environnement / Service ─────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info                  # info|debug|warn|error

# ─── Principal Backend URL ──────────────────────────────────────────────────
PRINCIPAL_URL=

# ─── MongoDB ────────────────────────────────────────────────────────────────
MONGO_URI_USERS=
MONGO_URI_TRANSACTIONS=

# ─── Redis (rate limiting) ──────────────────────────────────────────────────
# (optionnel – non utilisé si tu gardes l'araignée mémoire d'express-rate-limit)
REDIS_URL=

# ─── Client URL (CORS) ──────────────────────────────────────────────────────
# Accepte 1 ou plusieurs origines séparées par des virgules
CORS_ORIGIN=https://wwww.paynoval.com

# ─── JWT & HMAC ─────────────────────────────────────────────────────────────
JWT_SECRET=
INTERNAL_TOKEN=
JWT_EXPIRES_IN=1h
HMAC_SECRET=

# ─── SMTP (optionnel) ───────────────────────────────────────────────────────
# ── E-mail ──────────────────────────────────────────────────────────────────
# Les cinq SMTP_* ont ete retirees le 2026-09-10 : PayNoval n'envoie PAS par
# SMTP. La production envoie par SendGrid (SENDGRID_API_KEY), et aucun fichier
# du workspace ne lit process.env.SMTP_* — verifie avant retrait.
#
# Elles n'etaient plus exigees par la validation Joi depuis le 2026-09-02, mais
# survivaient ICI. Ce n'etait pas cosmetique : `dotenv-safe` valide l'ENV contre
# ce fichier, donc les declarer les rendait OBLIGATOIRES au demarrage. Tx-Core
# refusait de demarrer en reclamant SMTP_HOST — une variable qu'aucun code ne lit.

# ─── Micro-service emails (optionnel) ───────────────────────────────────────
EMAIL_MICROSERVICE_URL=

# 🌐 Exchange API
EXCHANGE_API_URL=               # ex: https://v6.exchangerate-api.com/v6/<API_KEY>
EXCHANGE_API_KEY=
EXCHANGE_CACHE_TTL=3600000      # ms (1h)

# ─── API Gateway URL ─────────────────────────────────────────────────────────
GATEWAY_URL=

# ─── Observabilité / Docs ───────────────────────────────────────────────────
SENTRY_DSN=                     # optionnel
OPENAPI_SPEC_PATH=./docs/openapi.yaml  # chemin vers ta spec OpenAPI pour /docs

# ─────────────────────────────────────────────────────────────────────────────
# SUPERVISION (monitoring)
# ─────────────────────────────────────────────────────────────────────────────
# Environnement résolu une fois par src/services/appEnv.js puis figé.
# Valeurs : development, staging, production, test. Défaut : development.
APP_ENV=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
