{
  "name": "paynoval-transactions-service",
  "version": "1.0.0",
  "description": "Micro-service de gestion des transactions PayNoval",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:concurrency": "node --test \"test-concurrency/**/*.test.js\"",
    "reconcile:referral": "node scripts/reconcileReferralPayouts.js",
    "verify:referral-idempotency": "node scripts/verifyReferralIdempotency.js",
    "reconcile:transactions": "node scripts/reconcileTransactions.js",
    "reconcile:wallet-ledger": "node scripts/reconcileWalletLedger.js",
    "replay:settlements": "node scripts/replaySettlements.js",
    "indexes:check": "node scripts/ensureIndexes.js",
    "indexes:apply": "node scripts/ensureIndexes.js --apply",
    "indexes:ledger": "node scripts/ensure-ledger-indexes.js --apply",
    "indexes:prune": "node scripts/dropRedundantTransactionIndexes.js",
    "indexes:prune:webhooks": "node scripts/dropRedundantWebhookIndexes.js",
    "worker:risk": "node workers/riskMonitor.js",
    "worker:settlement": "node workers/settlementMonitor.js",
    "worker:referral": "node workers/referralAward.js",
    "worker:notifications": "node workers/notificationDispatch.js",
    "workers:all": "node workers/all.js",
    "seed:cagnotte-pricing": "node scripts/seedCagnottePricingRules.js",
    "backfill:cagnotte-positions": "node scripts/backfillCagnotteVaultPositions.js"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^9.38.0",
    "axios": "^1.19.0",
    "axios-retry": "^4.5.0",
    "compression": "^1.8.0",
    "connect-timeout": "^1.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv-safe": "^8.2.0",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.11.2",
    "express-slow-down": "^3.1.1",
    "express-sslify": "^1.2.0",
    "express-validator": "^6.15.0",
    "helmet": "^6.2.0",
    "hpp": "^0.2.3",
    "http-errors": "^2.0.0",
    "ioredis": "^5.8.1",
    "joi": "^17.13.3",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.0",
    "lru-cache": "^11.1.0",
    "mongoose": "^7.8.7",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "pino": "^9.7.0",
    "prom-client": "^15.1.3",
    "promise-retry": "^2.0.1",
    "rate-limit-redis": "^4.2.2",
    "redis": "^5.1.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "xss-clean": "^0.1.4",
    "yaml": "^2.8.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": "20.x"
  }
}
